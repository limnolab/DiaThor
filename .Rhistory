with_mock_interactive <- function(code) {
original_interactive <- base::interactive
assignInNamespace("interactive", function() FALSE, ns = "base")
on.exit(assignInNamespace("interactive", original_interactive, ns = "base"))
code
}
with_mock_interactive({
if (interactive()) {
print("Esto no debería ejecutarse")
} else {
print("Simulando entorno no interactivo")
}
})
