}
return(NULL)
})
# Filter out NULL results and return lines with the character
result <- Filter(Negate(is.null), result)
if (length(result) > 0) {
return(list(file = filepath, occurrences = result))
}
return(NULL)
}
# Directory to search
dir_to_search <- "D:/GitHub repositories/DiaThor/man"
# List all files in the directory (including subdirectories)
all_files <- list.files(dir_to_search, recursive = TRUE, full.names = TRUE)
# Search for U+008D in all files and return line numbers
results <- lapply(all_files, search_for_unicode_line)
# Filter the results to show only the files with U+008D
results <- Filter(Negate(is.null), results)
# Print the results
if (length(results) > 0) {
for (file_result in results) {
cat("File:", file_result$file, "\n")
for (occurrence in file_result$occurrences) {
cat("Line:", occurrence$line, ":", occurrence$content, "\n")
}
cat("\n")
}
} else {
cat("No files containing U+008D were found.\n")
}
