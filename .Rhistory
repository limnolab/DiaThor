suppressWarnings({
con <- url(url, "r")
close(con)
})
TRUE
},
error = function(e) {
print("Error checking diatbarcode existence: 404, file not found")
FALSE
}
)
#if the file exists, we try to download it. This is extra steps are done to prevent 404 errors from aborting the whole function
